# Production targets are checked before test targets are declared. Public
# libraries cannot compile application sources or link application objects.
get_property(yquant_production_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
foreach(target IN LISTS yquant_production_targets)
  get_target_property(target_sources ${target} SOURCES)
  set(owner "")
  if(target MATCHES "^yquant_(strategyd|marketd|tradingd)(_objects)?$")
    set(owner "${CMAKE_MATCH_1}")
  endif()
  foreach(source IN LISTS target_sources)
    if(IS_ABSOLUTE "${source}")
      file(RELATIVE_PATH source "${PROJECT_SOURCE_DIR}" "${source}")
    endif()
    if(source MATCHES "(^|[:/])src/(strategyd|marketd|tradingd)/")
      if(NOT CMAKE_MATCH_2 STREQUAL owner)
        message(FATAL_ERROR
          "Target ${target} compiles private application source ${source}; move shared code into a library")
      endif()
    endif()
    if(source MATCHES "yquant_(strategyd|marketd|tradingd)_objects")
      if(NOT CMAKE_MATCH_1 STREQUAL owner)
        message(FATAL_ERROR
          "Target ${target} embeds private application objects ${source}")
      endif()
    endif()
  endforeach()
  foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(dependencies ${target} ${property})
    foreach(dependency IN LISTS dependencies)
      if(dependency MATCHES "yquant_(strategyd|marketd|tradingd)_objects")
        if(NOT CMAKE_MATCH_1 STREQUAL owner)
          message(FATAL_ERROR
            "Target ${target} depends on private application target ${dependency}")
        endif()
      endif()
    endforeach()
  endforeach()
endforeach()
