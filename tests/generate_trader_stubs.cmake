# The SDK has over 100 pure virtual methods. Generate failing test overrides
# for calls outside the login protocol, using this platform's SDK declarations.
set(trader_header "${td_headers}/ThostFtdcTraderApi.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${trader_header}")
file(STRINGS "${trader_header}" declarations REGEX "^[ \t]*virtual .*=[ \t]*0[ \t]*;")
set(stubs "")
foreach(decl IN LISTS declarations)
  if(decl MATCHES "(RegisterSpi|RegisterFront|SubscribePrivateTopic|SubscribePublicTopic|Release|Init|ReqAuthenticate|ReqUserLogin|ReqQryTradingAccount|ReqQryInvestorPosition)\\(")
    continue()
  endif()
  string(REGEX REPLACE "^[ \t]*virtual (.*)[ \t]*=[ \t]*0[ \t]*;.*$" "\\1" signature "${decl}")
  if(signature MATCHES "^void ")
    set(ret "")
  elseif(signature MATCHES "^int ")
    set(ret " return -1;")
  else()
    set(ret " return nullptr;")
  endif()
  string(APPEND stubs "${signature} override { ADD_FAILURE() << __func__;${ret} }\n")
endforeach()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/trader_test_sdk")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/trader_test_sdk/unused_trader_calls.inc" "${stubs}")
