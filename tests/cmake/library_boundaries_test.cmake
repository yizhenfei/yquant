cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED SOURCE_DIR OR NOT IS_DIRECTORY "${SOURCE_DIR}")
  message(FATAL_ERROR "SOURCE_DIR must identify the repository root")
endif()
get_filename_component(SOURCE_DIR "${SOURCE_DIR}" REALPATH)

# Remove comments while retaining quoted include operands. Treat raw strings
# as opaque so examples containing directives cannot trigger this check.
function(strip_comments source output)
  set(remaining "${source}")
  set(cleaned "")
  set(token_pattern
    "//[^\r\n]*|/\\*([^*]|\\*+[^*/])*\\*+/|R\"[^ ()\\\\\t\r\n]*\\(|\"([^\"\\\\]|\\\\.)*\"|'([^'\\\\]|\\\\.)*'")
  while(TRUE)
    string(REGEX MATCH "${token_pattern}" token "${remaining}")
    if(token STREQUAL "")
      string(APPEND cleaned "${remaining}")
      break()
    endif()
    string(FIND "${remaining}" "${token}" offset)
    string(SUBSTRING "${remaining}" 0 ${offset} prefix)
    string(APPEND cleaned "${prefix}")
    string(LENGTH "${token}" token_size)
    math(EXPR next "${offset} + ${token_size}")
    string(SUBSTRING "${remaining}" ${next} -1 remaining)
    if(token MATCHES "^R\"")
      math(EXPR delimiter_size "${token_size} - 3")
      string(SUBSTRING "${token}" 2 ${delimiter_size} delimiter)
      set(terminator ")${delimiter}\"")
      string(FIND "${remaining}" "${terminator}" end)
      if(end EQUAL -1)
        set(remaining "")
      else()
        string(LENGTH "${terminator}" terminator_size)
        math(EXPR next "${end} + ${terminator_size}")
        string(SUBSTRING "${remaining}" ${next} -1 remaining)
      endif()
      string(APPEND cleaned " ")
    elseif(token MATCHES "^/")
      # Preserve line boundaries, including a directive after a block comment.
      string(REGEX REPLACE "[^\r\n]" " " token "${token}")
      string(APPEND cleaned "${token}")
    else()
      string(REGEX REPLACE "[\r\n]" " " token "${token}")
      string(APPEND cleaned "${token}")
    endif()
  endwhile()
  set(${output} "${cleaned}" PARENT_SCOPE)
endfunction()

# owner is empty for libraries; executable sources may include their own
# private headers but cannot reach another executable's directory.
function(check_includes path owner)
  file(READ "${path}" source)
  string(REPLACE "\\\r\n" "" source "${source}")
  string(REPLACE "\\\n" "" source "${source}")
  strip_comments("${source}" remaining)
  while(TRUE)
    string(REGEX MATCH
      "(^|[\r\n])[ \t]*#[ \t]*include[ \t]*\"([^\"\r\n]+)\""
      directive "${remaining}")
    if(directive STREQUAL "")
      break()
    endif()
    set(header "${CMAKE_MATCH_2}")
    if(header MATCHES "(^|/)(strategyd|marketd|tradingd)/")
      set(included_owner "${CMAKE_MATCH_2}")
      if(NOT included_owner STREQUAL owner)
        file(RELATIVE_PATH relative "${SOURCE_DIR}" "${path}")
        message(SEND_ERROR
          "Library boundary violation in ${relative}: #include \"${header}\"")
        set(boundary_errors TRUE PARENT_SCOPE)
      endif()
    endif()
    string(FIND "${remaining}" "${directive}" offset)
    string(LENGTH "${directive}" directive_size)
    math(EXPR next "${offset} + ${directive_size}")
    string(SUBSTRING "${remaining}" ${next} -1 remaining)
  endwhile()
endfunction()

set(boundary_errors FALSE)
set(library_patterns)
foreach(component IN ITEMS base market model strategy trading)
  list(APPEND library_patterns "${SOURCE_DIR}/include/yquant/${component}/*.h")
endforeach()
foreach(component IN ITEMS base market trading)
  list(APPEND library_patterns "${SOURCE_DIR}/src/${component}/*.h"
    "${SOURCE_DIR}/src/${component}/*.cc")
endforeach()
file(GLOB_RECURSE library_files LIST_DIRECTORIES FALSE ${library_patterns})
foreach(path IN LISTS library_files)
  check_includes("${path}" "")
endforeach()

foreach(app IN ITEMS strategyd marketd tradingd)
  file(GLOB_RECURSE app_files LIST_DIRECTORIES FALSE
    "${SOURCE_DIR}/src/${app}/*.h" "${SOURCE_DIR}/src/${app}/*.cc")
  foreach(path IN LISTS app_files)
    check_includes("${path}" "${app}")
  endforeach()
endforeach()

if(NOT boundary_errors)
  message(STATUS "Library and executable include boundaries passed")
endif()
