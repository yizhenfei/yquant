#!/usr/bin/env python3
"""Run a bounded production configuration and verify its shutdown result."""
import argparse
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("config", type=Path)
    parser.add_argument("--binary", type=Path, default=Path("build/monod"))
    args = parser.parse_args()
    fields = {}
    for line in args.config.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key in fields:
            raise ValueError(f"duplicate configuration key: {key}")
        fields[key] = value
    run = int(fields.get("run_seconds", "0"))
    if run <= 0:
        raise ValueError("live verification requires a positive run_seconds")
    startup = int(fields.get("startup_seconds", "30"))
    shutdown = int(fields.get("shutdown_seconds", "10"))
    with tempfile.TemporaryDirectory(prefix="yquant-monod-") as flow:
        with subprocess.Popen(
            [str(args.binary.resolve()), "--config", str(args.config.resolve())],
            cwd=flow, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        ) as process:
            timed_out = False
            try:
                out, err = process.communicate(timeout=startup + run + shutdown + 10)
            except subprocess.TimeoutExpired:
                timed_out = True
                process.terminate()
                try:
                    out, err = process.communicate(timeout=shutdown + 5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    out, err = process.communicate()
            sys.stdout.write(out)
            sys.stderr.write(err)
            if timed_out or process.returncode:
                return 1
    matches = re.findall(r"^monod_stopped canceled=(\d+) remaining=0 commission=([^ ]+) realized=([^\n]+)$",
                         out, re.MULTILINE)
    if len(matches) != 1 or out.count("monod_started ") != 1:
        raise ValueError("missing unique startup/shutdown confirmation")
    canceled, commission, _ = matches[0]
    if int(canceled) == 0 and float(commission) == 0:
        raise ValueError("no canceled order or priced fill observed")
    print("simnow_monod_verified")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        sys.exit(f"SimNow monod verification failed: {error}")
