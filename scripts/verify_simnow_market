#!/usr/bin/env python3
"""Run the market-only client and compare each quote with its strategy intent."""
import argparse
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--monod", default="build/monod", type=Path)
    parser.add_argument("--anonymous", action="store_true")
    parser.add_argument("--front", default=os.getenv("YQUANT_CTP_MD_FRONT"))
    parser.add_argument("--symbol", default=os.getenv("YQUANT_CTP_SYMBOL"))
    parser.add_argument("--count", type=int, default=1)
    parser.add_argument("--timeout", type=int, default=30)
    args = parser.parse_args()
    if not args.front or not args.symbol:
        parser.error("specify a market front and a contract")
    if not 1 <= args.count <= 10000 or not 1 <= args.timeout <= 3600:
        parser.error("count must be 1..10000 and timeout must be 1..3600")
    with tempfile.TemporaryDirectory(prefix="yquant-ctp-") as flow:
        result = subprocess.run(
            [str(args.monod.resolve()), "--simnow-market",
             *(["--anonymous"] if args.anonymous else []), args.front, args.symbol,
             str(args.count), str(args.timeout)], cwd=flow,
            stdout=subprocess.PIPE, text=True, timeout=args.timeout + 5)
    sys.stdout.write(result.stdout)
    if result.returncode:
        return 1
    lines = [line for line in result.stdout.splitlines()
             if line.startswith(("simnow_quote ", "quote_intent ", "simnow_summary "))]
    if len(lines) != 2 * args.count + 1:
        raise ValueError("wrong number of quotes or intents")
    for i in range(args.count):
        quote_line, intent_line = lines[2*i:2*i+2]
        tag, *fields = quote_line.split()
        quote = dict(field.split("=", 1) for field in fields)
        expected = ("quote_intent instrument=1 sequence=" + str(i+1) +
                    " bid=" + quote["bid"] + " ask=" + quote["ask"])
        bid, ask = float(quote["bid"]), float(quote["ask"])
        if (tag != "simnow_quote" or quote["symbol"] != args.symbol or
            quote["instrument"] != "1" or int(quote["sequence"]) != i+1 or
            not (0 < bid < ask and math.isfinite(ask)) or
            min(int(quote["bid_qty"]), int(quote["ask_qty"])) <= 0 or
            intent_line != expected):
            raise ValueError("quote and strategy intent do not match")
    if lines[-1] != f"simnow_summary symbol={args.symbol} quotes={args.count}":
        raise ValueError("missing verified summary")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyError, ValueError, OSError, subprocess.TimeoutExpired) as exc:
        sys.exit(f"SimNow market verification failed: {exc}")
